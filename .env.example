# =============================================================================
# devclone Configuration Template (.env.example)
# =============================================================================
# Copy this file to `.env` in the project root (or `~/.config/devclone/config.env`)
# and customize the values for your environment:
#
#   cp .env.example .env
#
# Note: `.env` is ignored by Git so your private IPs, usernames, and SSH
# key paths are never committed to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. SSH Connection to Remote Device
# -----------------------------------------------------------------------------
# SSH username on the remote device where your projects are stored.
DEVCLONE_SSH_USER=john

# IP address or hostname of the remote device (e.g. LAN IP or Tailscale IP).
DEVCLONE_SSH_HOST=192.168.1.100

# SSH port on the remote device (default: 22).
DEVCLONE_SSH_PORT=22

# Optional: Full SSH target (e.g. `john@192.168.1.100` or an alias from ~/.ssh/config).
# Leave empty to automatically combine DEVCLONE_SSH_USER@DEVCLONE_SSH_HOST.
DEVCLONE_SSH_TARGET=

# Path to your private SSH key for passwordless login to the remote device.
# Leave empty to use your default ~/.ssh/config or SSH agent.
DEVCLONE_SSH_KEY=/home/john/.ssh/id_ed25519

# Timeout (in seconds) when establishing an SSH connection to the remote device.
DEVCLONE_SSH_CONNECT_TIMEOUT=8

# -----------------------------------------------------------------------------
# 2. Remote & Local Project Directories (Full Paths)
# -----------------------------------------------------------------------------
# Full path to the parent directory containing all project folders on the remote device.
DEVCLONE_REMOTE_PROJECTS_DIR=/home/john/Projects

# Full path to the parent directory on this local device where projects will be set up.
DEVCLONE_LOCAL_PROJECTS_DIR=/home/john/Projects

# -----------------------------------------------------------------------------
# 3. Local State Registry
# -----------------------------------------------------------------------------
# Path to the JSON file tracking which projects have already been provisioned
# on this device (enforces the One-Time Setup lock so existing projects are
# never accidentally overwritten).
DEVCLONE_STATE_FILE=/home/john/.config/devclone/state.json

# -----------------------------------------------------------------------------
# 4. Docker Volume, Database & File Sync Settings
# -----------------------------------------------------------------------------
# Lightweight Docker image containing `tar` and `gzip`, used to stream stopped
# Docker volumes read-only (:ro) between devices.
DEVCLONE_REMOTE_HELPER_IMAGE=redis:alpine
DEVCLONE_LOCAL_HELPER_IMAGE=redis:alpine

# Maximum size (in MB) of a stopped database volume to inspect via an ephemeral
# read-only mysqld/mariadbd process during `devclone diff`. Volumes larger than
# this threshold fall back to instant InnoDB (.ibd) tablespace stat comparison.
DEVCLONE_MAX_EPHEMERAL_SQL_MB=4500

# Minimum file size (in MB) for top-level .zip / .tar.gz archive files inside a
# project folder to be automatically skipped during `devclone setup` (saves time
# and disk space when projects contain old backup archives; override with --include-archives).
DEVCLONE_SKIP_ARCHIVE_MIN_MB=25

# Comma-separated glob patterns of backup archive filenames to exclude by default.
DEVCLONE_ARCHIVE_EXCLUDE_PATTERNS=backup.zip,*-backup.zip,*.tar.gz,*.sql.gz
